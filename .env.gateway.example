# Copy to .env.gateway on the server and fill in. Never commit .env.gateway.
GATEWAY_DB_PASSWORD=change-me-to-a-long-random-string
# 64 hex characters: openssl rand -hex 32. Keep a copy somewhere OTHER than this server (a password manager): without it
# the Halo signing secret in the database, and so every backup of it, cannot be read.
GATEWAY_ENCRYPTION_KEY=
# The public address of this gateway. Links to files (photos, voice notes) are built from it: it must be the https address the
# app and Halo reach, or files cannot be shown.
PUBLIC_BASE_URL=https://chat.vircle.tech
# The test page at https://chat.vircle.tech/simulator (opened from Halo, Settings, Channels). Set to false for a production launch.
SIMULATOR_ENABLED=true
# mock records alerts and sends nothing. The real Vircle push adapter comes with work package 8.
PUSH_ADAPTER=mock

# --- Operations (all optional; the defaults are right for the pilot) ---
# Bearer token for GET /metrics (queue sizes, memory, CPU for a monitor). Unset: the endpoint does not exist.
# Make one with: openssl rand -hex 24
METRICS_TOKEN=
# How many days delivered messages, files and events are kept (undelivered ones are kept three times as long). Halo keeps the conversation.
RETENTION_DAYS=30
# Logs are one JSON object per line. LOG_LEVEL: debug, info, warn, error. LOG_FORMAT=text for reading at a terminal.
LOG_LEVEL=info
# Conversations whose events are sent to Halo at the same moment. Raise it if Halo is slow and `outbox_oldest_seconds` grows.
DISPATCH_CONCURRENCY=16
# Connections to the gateway's own Postgres (its default limit is 100).
DB_POOL_MAX=20
