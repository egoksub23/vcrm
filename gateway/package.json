{
  "name": "vircle-chat-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Vircle Chat gateway: live connections for the Vircle app, signed events to and from Halo, push decision (docs/vircle-chat-gateway-scope.md)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "sim": "node build.mjs && tsx scripts/sim-dev.ts",
    "build:client": "node build.mjs && tsc -p client/tsconfig.build.json"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
